FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y \
    build-essential \
    curl \
    git \
    python3 \
    && rm -rf /var/lib/apt/lists/*

# Install Node.js
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - && \
    apt-get install -y nodejs

WORKDIR /app

COPY . .

# Build
WORKDIR /app/build/gmake
# Using release_arm64 config assuming we are running on arm64 host or using emulation
RUN make config=release_arm64

# Test
WORKDIR /app
# Mock the bin structure for quick.make
RUN mkdir -p bin/release-x64 && \
    cp bin/release-arm64/otfccdump bin/release-x64/otfccdump && \
    cp bin/release-arm64/otfccbuild bin/release-x64/otfccbuild && \
    chmod +x bin/release-x64/otfccdump bin/release-x64/otfccbuild

CMD ["make", "-f", "quick.make", "test"]
